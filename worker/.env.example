# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_APP_ID=clipper-worker

# --- Token encryption (32-byte hex string) ---
TOKEN_ENCRYPTION_KEY=

# --- Twitch ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=

# --- Kick ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_WEBHOOK_SECRET=

# --- Posting platforms ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- AI ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Web Push (must match frontend VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# --- Misc ---
FRONTEND_URL=https://app.example.com
NODE_ENV=production
PORT=8080
CLIP_DEFAULT_DURATION_SECONDS=30

# --- Cost rails (hard daily caps in cents; UTC reset) ---
ANTHROPIC_DAILY_CAP_CENTS=500
GROQ_DAILY_CAP_CENTS=200
# Set to false to log spend but never refuse calls (dev only).
COST_RAILS_ENFORCEMENT=true

# --- Observability ---
# Leave SENTRY_DSN blank to make Sentry a no-op.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Pipelines slower than this fire a Sentry warning.
SLOW_PIPELINE_THRESHOLD_SECONDS=180

# --- Admin endpoints (>=20 chars; leave blank to disable /admin routes) ---
ADMIN_SECRET=

# --- Face tracking (mediapipe sidecar) ---
# In the container these resolve to the cv-venv python and the bundled script.
FACE_TRACK_PYTHON=/opt/cv-venv/bin/python3
FACE_TRACK_SCRIPT=./scripts/face-track.py
FACE_TRACK_ENABLED=true
FACE_TRACK_SAMPLE_EVERY=5
