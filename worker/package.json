{
  "name": "clipper-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval.ts",
    "gen:db-types": "supabase gen types typescript --linked > src/types/db.ts",
    "remotion:preview": "remotion preview src/remotion/Root.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@hono/node-server": "^1.13.7",
    "@remotion/bundler": "^4.0.463",
    "@remotion/cli": "^4.0.230",
    "@remotion/renderer": "^4.0.230",
    "@sentry/node": "^10.53.1",
    "@supabase/supabase-js": "^2.46.1",
    "groq-sdk": "^0.8.0",
    "hono": "^4.6.11",
    "inngest": "^3.27.4",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.230",
    "tmi.js": "^1.8.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/tmi.js": "^1.8.6",
    "@types/web-push": "^3.6.3",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
